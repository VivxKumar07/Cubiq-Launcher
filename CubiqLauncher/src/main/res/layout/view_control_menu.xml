<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/background_card"
    android:padding="14dp"
    tools:ignore="UseSwitchCompatOrMaterialXml">

    <!-- Top Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/option_edit_controls"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:paddingBottom="8dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/text_background_fill"
        android:layout_marginBottom="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- SECTION: ADD CONTROLS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ADD CONTROLS"
                android:textStyle="bold"
                android:textColor="#9E9EA4"
                android:textSize="11sp"
                android:letterSpacing="0.05"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp" />

            <com.movtery.zalithlauncher.ui.view.AnimTextView
                android:id="@+id/add_button"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/btn_minecraft_stone"
                android:text="@string/customctrl_addbutton"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                app:ripple_for_text="false"/>

            <com.movtery.zalithlauncher.ui.view.AnimTextView
                android:id="@+id/add_drawer"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/btn_minecraft_stone"
                android:text="@string/customctrl_addbutton_drawer"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                app:ripple_for_text="false"/>

            <com.movtery.zalithlauncher.ui.view.AnimTextView
                android:id="@+id/add_joystick"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/btn_minecraft_stone"
                android:text="@string/customctrl_addbutton_joystick"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                app:ripple_for_text="false"/>

            <!-- SECTION: SAVE & LOAD -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SAVE &amp; LOAD"
                android:textStyle="bold"
                android:textColor="#9E9EA4"
                android:textSize="11sp"
                android:letterSpacing="0.05"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp" />

            <com.movtery.zalithlauncher.ui.view.AnimTextView
                android:id="@+id/load"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/btn_minecraft_stone"
                android:text="@string/generic_load"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                app:ripple_for_text="false"/>

            <com.movtery.zalithlauncher.ui.view.AnimTextView
                android:id="@+id/save"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/btn_minecraft_green"
                android:text="@string/generic_save"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                app:ripple_for_text="false"/>

            <com.movtery.zalithlauncher.ui.view.AnimTextView
                android:id="@+id/save_and_exit"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/btn_minecraft_green"
                android:text="@string/global_save_and_exit"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                app:ripple_for_text="false"/>

            <com.movtery.zalithlauncher.ui.view.AnimTextView
                android:id="@+id/save_and_export"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/btn_minecraft_green"
                android:text="@string/customctrl_export"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                app:ripple_for_text="false"/>

            <!-- SECTION: LAYOUT & SNAPPING -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SETTINGS &amp; SNAPPING"
                android:textStyle="bold"
                android:textColor="#9E9EA4"
                android:textSize="11sp"
                android:letterSpacing="0.05"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp" />

            <com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout
                android:id="@+id/snapping_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/btn_minecraft_stone"
                android:padding="8dp"
                app:ripple_for_relative="false">

                <TextView
                    android:id="@+id/snapping_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"
                    android:layout_marginEnd="8dp"
                    android:layout_toStartOf="@+id/snapping"
                    android:text="@string/controls_settings_button_snapping"
                    android:textColor="#FFFFFF"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <Switch
                    android:id="@+id/snapping"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true" />
            </com.movtery.zalithlauncher.ui.layout.AnimRelativeLayout>

            <LinearLayout
                android:id="@+id/snapping_distance_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/btn_minecraft_stone"
                android:padding="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/controls_settings_button_snapping_distance"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/snapping_distance_remove"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:gravity="center"
                        android:background="@drawable/btn_minecraft_stone"
                        android:text="-"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        tools:ignore="HardcodedText" />

                    <SeekBar
                        android:id="@+id/snapping_distance"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@id/snapping_distance_remove"
                        android:layout_toStartOf="@id/snapping_distance_add"
                        android:layout_marginHorizontal="6dp"
                        android:max="30"/>

                    <TextView
                        android:id="@+id/snapping_distance_add"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_centerVertical="true"
                        android:layout_toStartOf="@id/snapping_distance_value"
                        android:gravity="center"
                        android:background="@drawable/btn_minecraft_stone"
                        android:text="+"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/snapping_distance_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/background_text"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        tools:text="0 dp"/>

                </RelativeLayout>

            </LinearLayout>

            <!-- SECTION: TOOLS & ACTIONS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LAYOUT ACTIONS"
                android:textStyle="bold"
                android:textColor="#9E9EA4"
                android:textSize="11sp"
                android:letterSpacing="0.05"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp" />

            <com.movtery.zalithlauncher.ui.view.AnimTextView
                android:id="@+id/switch_movement"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/btn_minecraft_stone"
                android:text="@string/customctrl_switch_movement"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                app:ripple_for_text="false"/>

            <com.movtery.zalithlauncher.ui.view.AnimTextView
                android:id="@+id/mirror_layout"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/btn_minecraft_stone"
                android:text="@string/customctrl_mirror_layout"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                app:ripple_for_text="false"/>

            <com.movtery.zalithlauncher.ui.view.AnimTextView
                android:id="@+id/preview_layout"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/btn_minecraft_stone"
                android:text="@string/customctrl_preview_layout"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                app:ripple_for_text="false"/>

            <com.movtery.zalithlauncher.ui.view.AnimTextView
                android:id="@+id/reset_default"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/btn_minecraft_stone"
                android:text="@string/customctrl_reset_default"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                app:ripple_for_text="false"/>

            <com.movtery.zalithlauncher.ui.view.AnimTextView
                android:id="@+id/select_default"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/btn_minecraft_stone"
                android:text="@string/customctrl_selectdefault"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                app:ripple_for_text="false"/>

            <com.movtery.zalithlauncher.ui.view.AnimTextView
                android:id="@+id/exit"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/btn_minecraft_red"
                android:text="@string/customctrl_editor_exit"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                app:ripple_for_text="false"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
