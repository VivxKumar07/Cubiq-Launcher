        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="#606168" />
            <padding android:left="12dp" android:right="12dp" android:top="6dp" android:bottom="6dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="#4A4B50" />
            <padding android:left="12dp" android:right="12dp" android:top="6dp" android:bottom="6dp"/>
        </shape>
    </item>
</selector>
